# start.gg API token (get from https://developer.start.gg/)
START_GG_AUTH_TOKEN=

# Postgres connection (read automatically by the pg library)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres

# Path to the Amazon RDS CA bundle. Set in the container; leave unset locally
# to connect without SSL.
# DB_SSL_CA=/certs/rds-global-bundle.pem

# Scraper mode: startgg-full | startgg-incremental
SCRAPER_MODE=startgg-full

# Optional: restrict to a single game by start.gg video game ID
# GAME_ID=43868
